# ── 微信公众号凭据 ───────────────────────────────────────
# 测试号（沙箱）申请地址:
#   https://mp.weixin.qq.com/debug/cgi-bin/sandbox?t=sandbox/login
#
# 注意:
#   1. 接口测试号仅支持基础消息/菜单接口, 不支持 draft / freepublish / mass。
#   2. 真正发布内容需替换为「已认证订阅号」或「已认证服务号」的
#      AppID / AppSecret（在公众平台「设置与开发 → 基本配置」查看）。
#   3. 本文件为示例, 使用时复制为 scripts/.env 并填入真实值, 不要把
#      真实凭据提交到公开仓库。

WECHAT_APPID=wxREPLACE_WITH_YOUR_TEST_APPID
WECHAT_APPSECRET=REPLACE_WITH_YOUR_TEST_APPSECRET
